# ------------------------------------------------------------
# WarBrief V0.1 — 先复制为 .env，再按需填写
# ------------------------------------------------------------
APP_ENV=development
DEMO_MODE=true
HOST=0.0.0.0
PORT=8000
WARBRIEF_DATA_DIR=./data/runtime

# 新闻采集：启动时刷新，并按周期轮询。
NEWS_SCHEDULER_ENABLED=true
NEWS_REFRESH_ON_STARTUP=true
NEWS_POLL_INTERVAL_MINUTES=30
NEWS_LOOKBACK_HOURS=24
NEWS_MAX_ITEMS=60
NEWS_RETENTION_DAYS=14
NEWS_GDELT_ENABLED=true
NEWS_GDELT_QUERY=(military OR defense OR missile OR navy OR airforce OR NATO OR drone)
# 逗号分隔。留空时使用内置官方 RSS 示例。
NEWS_RSS_URLS=
# 在没有网络或真实结果时自动注入演示新闻，保证流程可运行。
NEWS_MOCK_FALLBACK=true

# OpenAI-compatible Chat Completions 接口。
# 例如你的服务根地址以 /v1 结尾，程序会请求 /chat/completions。
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=120

# 配音：mock=本地 espeak/静音回退；edge=Edge 在线语音；
# openai_compatible=兼容 /audio/speech 的服务。
TTS_PROVIDER=mock
TTS_VOICE=zh-CN-YunxiNeural
TTS_RATE=+0%
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=tts-1
TTS_TIMEOUT_SECONDS=180

# 素材：DVIDS 需要申请 API key；Wikimedia 无需 key。
DVIDS_API_KEY=
DVIDS_ENABLED=true
DVIDS_PREFER_VIDEO=true
# 优先选择不高于此码率的 MP4，避免 Demo 拉取超大母版。
DVIDS_VIDEO_MAX_BITRATE_KBPS=3000
WIKIMEDIA_ENABLED=true
MEDIA_ALLOW_PLACEHOLDER=true
MEDIA_DOWNLOAD_TIMEOUT_SECONDS=60

# 视频参数。demo 默认 720x1280；改为 1080x1920 即生产分辨率。
VIDEO_WIDTH=720
VIDEO_HEIGHT=1280
VIDEO_FPS=25
VIDEO_CRF=22
VIDEO_PRESET=veryfast
VIDEO_MAX_SENTENCES=8
VIDEO_MIN_SENTENCE_SECONDS=2.2
VIDEO_MAX_SENTENCE_SECONDS=7.0
BGM_PATH=

# 网络代理，可用于新闻、素材和 Edge TTS 所需的外网访问。
HTTP_PROXY_URL=
